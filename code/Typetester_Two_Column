                                            1,
                                            setWeight
                                        )
                                    }
                                    onTouchStart={(e) =>
                                        handleDrag(
                                            e,
                                            wghtAxis.minValue,
                                            wghtAxis.maxValue,
                                            1,
                                            setWeight
                                        )
                                    }
                                >
                                    <div
                                        style={{
                                            ...trackStyleFn(
                                                pct(
                                                    weight,
                                                    wghtAxis.minValue,
                                                    wghtAxis.maxValue
                                                )
                                            ),
                                            background:
                                                weightPillForeground ||
                                                "#FFFFFF",
                                        }}
                                    />
                                    <div
                                        style={{
                                            ...thumbStyleFn(
                                                pct(
                                                    weight,
                                                    wghtAxis.minValue,
                                                    wghtAxis.maxValue
                                                )
                                            ),
                                            background:
                                                weightPillForeground ||
                                                "#FFFFFF",
                                            boxShadow: `0 0 0 3px ${weightPillColor || foreground}`,
                                        }}
                                    />
                                </div>
                                <span
                                    style={{
                                        ...sliderValueStyle,
                                        color:
                                            weightPillForeground || "#FFFFFF",
                                        paddingTop: 1,
                                    }}
                                >
                                    {weight}
                                </span>
                            </div>
                        </>
                    )}
                </div>

                {/* OT Features pill — hidden when the current style has no toggleables */}
                {(!featuresLoaded || toggleable.length > 0) && (
                    <div style={otPillStyle} onClick={() => setOtOpen(!otOpen)}>
                        <span style={{ paddingTop: 2 }}>OT Features</span>
                        <span
                            style={{
                                display: "inline-flex",
                                alignItems: "center",
                                justifyContent: "center",
                                transform: otOpen
                                    ? "rotate(180deg)"
                                    : "rotate(0deg)",
                                transition: "transform 0.25s ease",
                            }}
                        >
                            <svg width="12" height="7" viewBox="0 0 12 7">
                                <polyline
                                    points="1,1 6,6 11,1"
                                    stroke="currentColor"
                                    strokeWidth="1"
                                    strokeLinecap="square"
                                    fill="none"
                                />
                            </svg>
                        </span>
                    </div>
                )}
            </div>

            {/* OT Features panel */}
            {(!featuresLoaded || toggleable.length > 0) && (
                <div style={otPanelStyle}>
                    <div style={otPanelInnerStyle}>
                        <div style={otPanelGridStyle}>
                            {toggleable.length === 0 && (
                                <div style={{ opacity: 0.6 }}>
                                    No features available
                                </div>
                            )}
                            {toggleable.map((tag) => {
                                const active = activeFeatures.has(tag)
                                return (
                                    <div
                                        key={tag}
                                        style={otRowStyle}
                                        onClick={() => toggleFeature(tag)}
                                    >
                                        <div style={otCheckboxStyle}>
                                            {active && (
                                                <div
                                                    style={{
                                                        width: 8,
                                                        height: 8,
                                                        background: foreground,
                                                    }}
                                                />
                                            )}
                                        </div>
                                        <span>{getFeatureLabel(tag)}</span>
                                        <span
                                            style={{
                                                marginLeft: "auto",
                                                fontFamily: uiFontChain,
                                                fontSize: 14,
                                                lineHeight: "14px",
                                            }}
                                        >
                                            {tag}
                                        </span>
                                    </div>
                                )
                            })}
                        </div>
                    </div>
                </div>
            )}

            {/* Editable multi-column specimen text */}
            <div
                contentEditable
                suppressContentEditableWarning
                spellCheck={false}
                style={textStyle}
            >
                {sampleText}
            </div>
        </div>
    )
}
