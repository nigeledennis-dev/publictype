            }}
        >
            {/* Top bar */}
            <div style={barStyle}>
                {/* Left cluster: font family pill + style pill */}
                <div style={leftClusterStyle}>
                    {/* Font family pill — dropdown when > 1 sub-family */}
                    <div
                        ref={subPillRef}
