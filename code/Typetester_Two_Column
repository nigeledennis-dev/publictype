import * as React from "react"
import { addPropertyControls, ControlType } from "framer"

/**
 * TYPE TESTER — TWO COLUMN
 *
 * Single-instance tester for Public Type where the specimen text flows
 * across 2 newspaper-style columns below a shared top bar.
 *
 * Top bar:
 *   [Font Family Pill ▾] [Style Pill ▾] | Size | Leading | Tracking | OT
 *
 * The font family pill is a dropdown across every sub-family in the
 * super family (or the filtered subset in `subFamilySlugs`). The style
 * pill selects a member of the currently-active sub-family. Changing
 * the family swaps the row's active sub-family; the style is remapped
 * to the nearest match in the new sub-family so the UI keeps its place.
 *
 * @framerSupportedLayoutWidth any
 * @framerSupportedLayoutHeight any
 * @framerIntrinsicWidth 1440
 * @framerIntrinsicHeight 600
 */
export default function TypeTesterTwoColumn(props: TesterProps) {
    return <MultiColumnTester {...props} columnCount={2} />
}

TypeTesterTwoColumn.defaultProps = DEFAULT_PROPS()

addPropertyControls(TypeTesterTwoColumn, PROPERTY_CONTROLS())

