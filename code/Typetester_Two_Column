                        }}
                        onMouseDown={
                            hasMultipleSubFamilies
                                ? (e) => {
                                      e.preventDefault()
                                      setSubMenuOpen((v) => !v)
                                  }
                                : undefined
                        }
                    >
                        <span style={namePillLabelStyle}>
                            {collectionName || "\u00a0"}
                        </span>
                        {hasMultipleSubFamilies && (
                            <span
                                style={{
                                    display: "inline-flex",
                                    alignItems: "center",
                                    justifyContent: "center",
                                    color: namePillText,
                                    transform: subMenuOpen
                                        ? "rotate(180deg)"
